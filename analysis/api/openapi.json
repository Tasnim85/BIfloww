{
 "openapi": "3.1.0",
 "info": {
  "title": "BIFlow API — Analyst & KPI catalog",
  "description": "\nRabeb's part of BIFlow, over HTTP.\n\n* **Analyst (step 5, BO3-03)**: the KPI computed with SQL built from the approved catalog, the 4\n  validation checks, and insights written by an LLM agent (every number fact-checked).\n* **KPI catalog**: the approved KPIs and the glossary, and a KPI computed live with its checks.\n* **KPI proposer**: a draft catalog for any warehouse, reviewed by a human before use.\n\nEvery response is a contract of `contracts/` (version in `/health`).\n",
  "version": "1.1"
 },
 "paths": {
  "/api/runs/{run_id}/analysis": {
   "post": {
    "tags": [
     "analysis"
    ],
    "summary": "Analyse",
    "description": "Run the Analyst (step 5) on a run: SQL compiled from the catalog, the 4 BO3-03 checks,\nthen the insights. Needs the run's request and warehouse. Status 'failed' = a check failed\nor the request asks for something the catalog does not allow (see message).",
    "operationId": "analyse_api_runs__run_id__analysis_post",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,64}$",
       "title": "Run Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/RunAnalysis"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RunAnalysisResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "get": {
    "tags": [
     "analysis"
    ],
    "summary": "Analysis",
    "description": "The Analyst's answer: value, comparison, KPI version, exact SQL, BO3-03 checks, insights.",
    "operationId": "analysis_api_runs__run_id__analysis_get",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,64}$",
       "title": "Run Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AnalysisResult"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/api/runs/{run_id}/analysis/rows": {
   "get": {
    "tags": [
     "analysis"
    ],
    "summary": "Rows",
    "description": "result.parquet as JSON (dimensions..., period, value): the data of the charts.",
