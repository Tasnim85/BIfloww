    }
   }
  },
  "/api/runs/{run_id}/kpi-proposal": {
   "post": {
    "tags": [
     "KPI catalog"
    ],
    "summary": "Kpi Proposal",
    "description": "A DRAFT catalog + glossary for this run's warehouse (any dataset). Approved KPIs keep their\nname, version, unit and filters. Nothing is written into kpi/catalog.yaml: a human reviews it.",
    "operationId": "kpi_proposal_api_runs__run_id__kpi_proposal_post",
    "parameters": [
     {
      "name": "run_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_-]{1,64}$",
       "title": "Run Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ProposeKpis"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/KpiProposal"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/health": {
