{
  "name": "cleaning",
  "version": "1.0",
  "description": "Enlever les espaces inutiles et remplacer les textes vides par des valeurs absentes. Conserver toutes les lignes et les types.",
  "required_tables": [
    "customers",
    "orders",
    "order_items",
    "order_payments",
    "products",
    "sellers"
  ],
  "actions": {
    "trim_strings": true,
    "empty_strings_to_null": true,
    "remove_exact_duplicate_rows": false
  },
  "deduplicate_tables": [],
  "numeric_columns": {},
  "date_columns": {},
  "critical_nonnegative_columns": {},
  "required_values": {
    "orders": [
      "order_id",
      "customer_id",
      "order_purchase_timestamp",
      "order_status"
    ],
    "order_items": [
      "order_id",
      "order_item_id",
      "product_id",
      "seller_id"
    ],
    "order_payments": [
      "order_id",
      "payment_sequential"
    ],
    "customers": [
      "customer_id"
    ],
    "products": [
      "product_id"
    ],
    "sellers": [
      "seller_id"
    ]
  }
}
