# Copy this file to .env.local and fill it. NEVER commit .env.local.

# Where the Python API runs (uvicorn api.main:app --port 8000)
BACKEND_URL=http://127.0.0.1:8000

# Address of this app, and a long random secret for the sessions.
# Create the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA v2 CHECKBOX (https://www.google.com/recaptcha/admin): type "Challenge (v2)" >
# "I'm not a robot" checkbox, domain "localhost". Restart `npm run dev` after editing this file.
# Without keys: reCAPTCHA is skipped in development and REFUSED in production.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SQLite file for users and history (created automatically)
DATABASE_PATH=./data/askboard.db

# ---- Welcome email (optional) ----
# Any SMTP server. Gmail: turn on 2-step verification, create an "App password", then
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASS=<16-letter app password>
# Without SMTP_HOST, in development the email is saved in data/outbox/ (open the .html file in a browser).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Askboard <you@gmail.com>"
# Only if an antivirus scans your emails ("self-signed certificate"): its root certificate, trusted for SMTP only
SMTP_CA_FILE=
